# ---------------------------------------------------------------------------
# GigVault — environment variables
# Copy this file to .env.local and fill in the values for your deployment.
# Every NEXT_PUBLIC_* var is exposed to the browser — never put secrets here.
# ---------------------------------------------------------------------------

# The deployed GigVault contract ID (starts with "C...").
# scripts/deploy.sh fills this in automatically after a successful deploy;
# set it manually if you're pointing the frontend at an existing deployment.
NEXT_PUBLIC_CONTRACT_ID=CONTRACT_ADDRESS_HERE

# The SAC (Stellar Asset Contract) used as the escrow token.
# scripts/deploy.sh defaults to the testnet native XLM SAC.
NEXT_PUBLIC_TOKEN_ID=

# Soroban RPC + Horizon endpoints. Defaults below are Stellar's public
# testnet endpoints — override only if you're running your own node.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Local-only: identity names used by scripts/deploy.sh and
# scripts/setup-identity.sh (stellar-cli keys, not funded secret keys).
GIGVAULT_ADMIN_IDENTITY=gigvault-admin
GIGVAULT_ARBITRATOR_IDENTITY=gigvault-arbitrator
